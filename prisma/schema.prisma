// Prisma schema file for Imob Giro e Agro (Bevi Ajuda style platform)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  icon        String?   // Icon identifier (e.g. "home", "building", "sprout", "shield")
  articles    Article[]
}

model Article {
  id           String       @id @default(uuid())
  title        String
  summary      String
  content      String       // Detailed Markdown / HTML text rules
  categoryId   String
  category     Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attachments  Attachment[]
  updatedAt    DateTime     @updatedAt
  createdAt    DateTime     @default(now())
}

model Attachment {
  id        String   @id @default(uuid())
  name      String
  fileUrl   String   // Direct URL or local path to PDF / material
  fileType  String   @default("pdf")
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

model InstitutionProduct {
  id           String        @id @default(uuid())
  bankName     String        // ex: "Caixa Econômica", "Itaú", "Banco do Brasil Agro", "Santander PJ"
  segment      String        // "Imobiliário", "Crédito PJ", "Crédito Agro"
  description  String?
  triggerTiers TriggerTier[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model TriggerTier {
  id                   String             @id @default(uuid())
  minVolume            Float              // Minimum volume in BRL (ex: 0, 500000)
  maxVolume            Float?             // Maximum volume in BRL (null means unlimited "+")
  commissionRate       Float              // Percentage rate (ex: 1.5 for 1.5%)
  institutionProductId String
  institutionProduct   InstitutionProduct @relation(fields: [institutionProductId], references: [id], onDelete: Cascade)
}

model AdminSession {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}
